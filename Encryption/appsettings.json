{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "Encryption.Issuer",
    "Audience": "Encryption.Audience",
    "Key": "PLACEHOLDER_JWT_KEY_SET_VIA_ENV_OR_USER_SECRETS"
  },
  "IpHashPepper": "PLACEHOLDER_PEPPER_SET_VIA_ENV_OR_USER_SECRETS",
  "ConnectionStrings": {
    "Redis": "localhost:6379,abortConnect=false",
    "SqlMaster": "Server=localhost;Database=EncryptionDb;Trusted_Connection=True;TrustServerCertificate=True;",
    "SqlReplica": "Server=localhost;Database=EncryptionDb;Trusted_Connection=True;TrustServerCertificate=True;",
    "MongoDb": "PLACEHOLDER_MONGODB_CONNECTION_STRING"
  },
  "MongoDbDatabaseName": "EncryptionDb",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "https://localhost:4200"
    ]
  }
}
